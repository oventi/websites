<!doctype html>
<html lang="en">

<head>
  <title>Multicultural Collective</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />

  <link rel="icon" type="image/png" href="/favicon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

  <link href="/assets/css/multiculturalcollective.css" rel="stylesheet">
</head>

<body>

  {{> header}}

  <main>
    <div class="container-fluid">
      <div id="header" class="row">
        <div class="col px-0">
          <img src="/images/mc-website-header.png" alt="image containing a collage of our past 6 events" />
        </div>
      </div>
    </div>

    <div class="container">

      <div id="about" class="row m-4 p-4">
        <div class="col-12 fs-5 text-center">

          Multicultural Collective is a group that organises projects and events that foster multicultural and intersectional solidarity, 
          increase social cohesion and make a positive impact in Tawa and Porirua. We collaborate with people and organisations 
          that align with our values. Our workshops are small and community focused with the goal of learning and connecting.

        </div>
      </div>

      <div id="events" class="row mt-4">
        <h2 class="h4">Upcoming events</h2>

        <div class="row mt-3">

          {{#events}}
          <div class="col-12 col-sm-6 col-xl-3 mb-2">
            <div class="card border-0">
              <img src="{{image_url}}" class="card-img-top" alt="">
              <div class="card-body px-0 py-3">
                <h3 class="card-title h5">{{title}}</h3>
                <p class="card-subtitle mb-2 text-body-secondary">{{sub_title}}</p>
                <div class="d-grid gap-2">
                  <a href="{{action.link}}" class="btn btn-primary register">{{action.text}}</a>
                </div>
              </div>
            </div>
          </div>
          {{/events}}

        </div>
      </div>

      <div id="past_events" class="row mt-4">
        <h2 class="h4">Past events</h2>

        <div class="row mt-3">

          {{#past_events}}
          <div class="col-12 col-sm-6 col-xl-3 mb-2">
            <div class="card border-0">
              <img src="{{image_url}}" class="card-img-top" alt="">
              <div class="card-body px-0 py-3">
                <h3 class="card-title h5">{{title}}</h3>
                <p class="card-subtitle mb-2 text-body-secondary">{{sub_title}}</p>
              </div>
            </div>
          </div>
          {{/past_events}}

        </div>
      </div>
    </div>
  </main>

  {{> footer}}

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
</body>

</html>
